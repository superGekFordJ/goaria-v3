{
  "name": "goaria-browser-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env EXTENSION_TARGET=chrome vite build --watch",
    "build:chrome": "cross-env EXTENSION_TARGET=chrome vite build",
    "build:firefox": "cross-env EXTENSION_TARGET=firefox vite build",
    "watch:chrome": "cross-env EXTENSION_TARGET=chrome vite build --watch",
    "watch:firefox": "cross-env EXTENSION_TARGET=firefox vite build --watch",
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "zip:chrome": "cd dist/chrome && 7z a -tzip ../../goaria-extension-chrome.zip *",
    "zip:firefox": "cd dist/firefox && 7z a -tzip ../../goaria-extension-firefox.zip *",
    "package": "pnpm run build && pnpm run zip:chrome && pnpm run zip:firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --fix",
    "format": "prettier --write \"*.{js,ts,json}\" \"src/**/*.{js,ts,svelte,css,html}\""
  },
  "dependencies": {
    "hls-parser": "0.16.1",
    "webext-bridge": "6.0.1",
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@samrum/vite-plugin-web-extension": "5.1.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.12.2",
    "@types/webextension-polyfill": "0.12.5",
    "cross-env": "10.1.0",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.20.0",
    "globals": "17.7.0",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.3",
    "vite-plugin-environment": "1.1.3"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
