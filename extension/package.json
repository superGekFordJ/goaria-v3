{
  "name": "goaria-browser-extension",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "cross-env EXTENSION_TARGET=chrome vite build --watch",
    "build:chrome": "cross-env EXTENSION_TARGET=chrome vite build",
    "build:firefox": "cross-env EXTENSION_TARGET=firefox vite build",
    "watch:chrome": "cross-env EXTENSION_TARGET=chrome vite build --watch",
    "watch:firefox": "cross-env EXTENSION_TARGET=firefox vite build --watch",
    "build": "pnpm run build:chrome && pnpm run build:firefox",
    "zip:chrome": "node scripts/zip.js chrome",
    "zip:firefox": "node scripts/zip.js firefox",
    "package": "pnpm run build && node scripts/zip.js",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "gen:i18n": "node scripts/gen-i18n-types.js",
    "check:i18n": "node scripts/gen-i18n-types.js && node scripts/check-i18n-keys.js && node scripts/check-hardcode.js",
    "lint": "eslint . --fix && pnpm run check:i18n",
    "format": "prettier --write \"*.{js,ts,json}\" \"src/**/*.{js,ts,svelte,css,html}\""
  },
  "dependencies": {
    "hls-parser": "0.16.1",
    "webext-bridge": "6.0.1",
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@samrum/vite-plugin-web-extension": "5.1.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.12.2",
    "@types/webextension-polyfill": "0.12.5",
    "cross-env": "10.1.0",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.20.0",
    "globals": "17.7.0",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.3",
    "vite-plugin-environment": "1.1.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
