{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,html}\"",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "detect:i18n": "eslint -c eslint-i18n.config.js . --format json --output-file eslint-report.json --no-error-on-unmatched-pattern || node ../scripts/parse_eslint_report.js"
  },
  "dependencies": {
    "@lucide/vue": "^1.27.0",
    "@tailwindcss/vite": "^4.3.3",
    "@wailsio/runtime": "3.0.0-beta.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7",
    "vue-virtual-scroller": "3.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
